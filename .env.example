############################################
# Tour Server environment variables
############################################

# Server
PORT=5000
NODE_ENV=development

# Database 
DB_URL=mongodb+srv://practiceAllProject:nzmIQqnXm6N6ix9L@cluster0.g0svigm.mongodb.net/tour-management-server?retryWrites=true&w=majority&appName=Cluster0


# Auth / Security
BCRYPT_SALT_ROUND=10
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES=30d

# Seed super admin 
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=Admin@12345

# Frontend
FRONTEND_URL=http://localhost:5173

# Production example:
# FRONTEND_URL=https://tour-organizer-tawny.vercel.app

# Google OAuth (Passport)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Production example:
# GOOGLE_CALLBACK_URL=https://tour-organizer-server.vercel.app/api/v1/auth/google/callback

# Express session
EXPRESS_SESSION_SECRET=change_this_session_secret

############################################
# SSLCommerz (Sandbox defaults)
############################################

# Provided by SSLCommerz (sandbox/live)
SSL_STORE_ID=tourt687d1dfe3292c
SSL_STORE_PASS=tourt687d1dfe3292c@ssl

# Sandbox endpoints (recommended for local dev)
SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# Backend redirect endpoints (must match your backend routes)
SSL_SUCCESS_BACKEND_URL=http://localhost:5000/api/v1/payment/success
SSL_FAIL_BACKEND_URL=http://localhost:5000/api/v1/payment/fail
SSL_CANCEL_BACKEND_URL=http://localhost:5000/api/v1/payment/cancel

# Frontend redirect pages
SSL_SUCCESS_FRONTEND_URL=http://localhost:5173/payment/success
SSL_FAIL_FRONTEND_URL=http://localhost:5173/payment/fail
SSL_CANCEL_FRONTEND_URL=http://localhost:5173/payment/cancel

# IPN (instant payment notification) -> backend route
SSL_IPN_URL=http://localhost:5000/api/v1/payment/validate-payment

# Production examples:
# SSL_SUCCESS_BACKEND_URL=https://tour-organizer-server.vercel.app/api/v1/payment/success
# SSL_FAIL_BACKEND_URL=https://tour-organizer-server.vercel.app/api/v1/payment/fail
# SSL_CANCEL_BACKEND_URL=https://tour-organizer-server.vercel.app/api/v1/payment/cancel
# SSL_SUCCESS_FRONTEND_URL=https://tour-organizer-tawny.vercel.app/payment/success
# SSL_FAIL_FRONTEND_URL=https://tour-organizer-tawny.vercel.app/payment/fail
# SSL_CANCEL_FRONTEND_URL=https://tour-organizer-tawny.vercel.app/payment/cancel
# SSL_IPN_URL=https://tour-organizer-server.vercel.app/api/v1/payment/validate-payment

############################################
# Cloudinary (Multer storage)
############################################

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloud_api_key
CLOUDINARY_API_SECRET=your_cloud_api_secret

############################################
# SMTP (Email sender)
############################################

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Tour Organizer <your_email@gmail.com>"

############################################
# Redis
############################################

# Local example (no auth)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=default
